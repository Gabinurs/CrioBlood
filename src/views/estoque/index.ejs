<%- include('../partials/inicio', { titulo: 'Bolsas (Estoque)', subtitulo: 'Situação atual das bolsas em estoque', ativo: 'estoque' }) %>

<section class="indicadores">
    <div class="indicador destaque-verde"><strong><%= resumo.disponiveis %></strong><span>Disponíveis</span></div>
    <div class="indicador destaque-azul"><strong><%= resumo.reservadas %></strong><span>Reservadas</span></div>
    <div class="indicador destaque-amarelo"><strong><%= resumo.em_conferencia %></strong><span>Em conferência</span></div>
    <div class="indicador destaque-vermelho"><strong><%= resumo.vencendo %></strong><span>Vencem em 7 dias</span></div>
</section>

<section class="painel">
    <h3>Disponíveis por tipagem e produto</h3>
    <p class="descricao">Apenas bolsas disponíveis e dentro da validade.</p>
    <div class="tabela-container">
        <table>
            <thead>
                <tr>
                    <th>ABO/Rh</th>
                    <% tipos.forEach(function (t) { %><th class="centro"><%= t %></th><% }) %>
                    <th class="centro">Total</th>
                </tr>
            </thead>
            <tbody>
                <% matriz.linhas.forEach(function (l) { %>
                    <tr>
                        <td><strong><%= l.rotulo %></strong></td>
                        <% tipos.forEach(function (t) { %>
                            <td class="centro"><%= l.valores[t] || '—' %></td>
                        <% }) %>
                        <td class="centro"><strong><%= l.total %></strong></td>
                    </tr>
                <% }) %>
                <tr>
                    <td><strong>Total</strong></td>
                    <% matriz.porTipo.forEach(function (t) { %><td class="centro"><strong><%= t.total %></strong></td><% }) %>
                    <td class="centro"><strong><%= resumo.disponiveis %></strong></td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="painel" data-filtravel>
    <h3>Bolsas em estoque</h3>
    <p class="descricao">Disponíveis, reservadas e em conferência, da validade mais próxima para a mais distante.</p>

    <div class="filtros">
        <input type="search" data-filtro-texto placeholder="Buscar por código ou lote..." aria-label="Buscar bolsa">
        <select data-filtro-campo="status" aria-label="Filtrar por status">
            <option value="">Todos os status</option>
            <option value="DISPONIVEL">Disponíveis</option>
            <option value="RESERVADA">Reservadas</option>
            <option value="EM_CONFERENCIA">Em conferência</option>
        </select>
        <select data-filtro-campo="tipo" aria-label="Filtrar por produto">
            <option value="">Todos os produtos</option>
            <% tipos.forEach(function (t) { %><option value="<%= t %>"><%= rot.tipo(t) %></option><% }) %>
        </select>
    </div>

    <div class="tabela-container">
        <table>
            <thead>
                <tr><th>Código</th><th>Lote</th><th>Produto</th><th>ABO/Rh</th><th>Validade</th><th>Prazo</th><th>Status</th><th>Localização</th><th></th></tr>
            </thead>
            <tbody>
                <% if (bolsas.length === 0) { %>
                    <tr><td colspan="9" class="vazio">Nenhuma bolsa em estoque.</td></tr>
                <% } else { bolsas.forEach(function (b) { %>
                    <tr data-busca="<%= (b.codigo_original + ' ' + b.codigo_lote).toLowerCase() %>" data-status="<%= b.status %>" data-tipo="<%= b.tipo %>">
                        <td><strong><%= b.codigo_original %></strong></td>
                        <td><%= b.codigo_lote %></td>
                        <td><%= b.tipo %></td>
                        <td><%= rot.tipagem(b.abo, b.fator_rh) %></td>
                        <td><%= b.validade_br %></td>
                        <td><%- rot.validade(b.dias_restantes) %></td>
                        <td><%- rot.statusBolsa(b.status) %></td>
                        <td><%= rot.local(b) %></td>
                        <td class="acoes">
                            <a class="botao botao-claro botao-pequeno" href="/estoque/<%= b.id %>/localizacao"><%= b.equipamento ? 'Mover' : 'Definir local' %></a>
                            <a class="botao botao-claro botao-pequeno" href="/hemocomponentes/editar/<%= b.id %>">Abrir</a>
                        </td>
                    </tr>
                <% }) %>
                    <tr data-sem-resultado hidden><td colspan="9" class="vazio">Nenhuma bolsa encontrada com esse filtro.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>

<%- include('../partials/fim') %>
