<%- include('../partials/inicio', { titulo: 'Bolsas do recebimento', subtitulo: lote ? 'Lote ' + lote.codigo : 'Consulta de bolsas registradas', ativo: 'recebimento' }) %>

<section class="cabecalho-pagina bolsas-recebimento-cabecalho">
    <div>
        <% if (lote) { %>
            <span class="recebimento-etiqueta">LOTE DE RECEBIMENTO</span>
            <h3><%= lote.codigo %></h3>
            <p><%= lote.origem || 'Origem não informada' %> · <%= lote.data_br %> · <%= lote.status === 'ABERTO' ? 'Recebimento em andamento' : 'Recebimento finalizado' %></p>
        <% } else { %>
            <h3>Consulta de bolsas</h3>
            <p>Visualize bolsas cadastradas. Para incluir novas bolsas, abra um lote no módulo Recebimento de bolsas.</p>
        <% } %>
    </div>
    <div class="acoes">
        <a class="botao botao-claro" href="/lotes">Voltar ao recebimento</a>
        <% if (lote && lote.status === 'ABERTO' && locals.pode && locals.pode('bolsas.gerenciar')) { %>
            <a class="botao" href="/hemocomponentes/novo?lote_id=<%= lote.id %>">＋ Adicionar outra bolsa</a>
        <% } %>
        <% if (lote && lote.status === 'FECHADO') { %>
            <a class="botao botao-claro" href="/lotes/<%= lote.id %>/relatorio">Comprovante PDF</a>
        <% } %>
    </div>
</section>

<section class="painel" data-filtravel>
    <div class="filtros">
        <input type="search" data-filtro-texto placeholder="Buscar por código original, código local ou lote..." aria-label="Buscar bolsa">
        <select data-filtro-campo="status" aria-label="Filtrar por status">
            <option value="">Todos os status</option>
            <% ['EM_CONFERENCIA', 'DISPONIVEL', 'RESERVADA', 'TRANSFUNDIDA', 'DESCARTADA', 'VENCIDA'].forEach(function (s) { %>
                <option value="<%= s %>"><%= rot.nomeStatusBolsa(s) %></option>
            <% }) %>
        </select>
    </div>

    <div class="tabela-container">
        <table>
            <thead>
                <tr><th>Código CrioBlood</th><th>Código original</th><th>Lote</th><th>Produto</th><th>ABO/Rh</th><th>Volume</th><th>Validade</th><th>Status</th><th>Ações</th></tr>
            </thead>
            <tbody>
                <% if (!hemocomponentes || hemocomponentes.length === 0) { %>
                    <tr><td colspan="9" class="vazio">Nenhuma bolsa encontrada neste recebimento.</td></tr>
                <% } else { hemocomponentes.forEach(function (item) { %>
                    <tr data-busca="<%= ((item.codigo_interno || '') + ' ' + item.codigo_original + ' ' + (item.codigo_lote || '')).toLowerCase() %>" data-status="<%= item.status %>">
                        <td><strong><%= item.codigo_interno || '—' %></strong></td>
                        <td><strong><%= item.codigo_original %></strong></td>
                        <td><%= item.codigo_lote || item.lote_id %></td>
                        <td><%= rot.tipo(item.tipo) %></td>
                        <td><%= rot.tipagem(item.abo, item.fator_rh) %></td>
                        <td><%= item.volume_ml ? item.volume_ml + ' mL' : '—' %></td>
                        <td><%= item.data_validade_br %></td>
                        <td>
                            <%- rot.statusBolsa(item.status) %>
                            <% if (item.status === 'DESCARTADA') { %>
                                <details>
                                    <summary>Dados do descarte</summary>
                                    <small>
                                        <strong>Motivo:</strong> <%= item.descarte_motivo || 'Não informado (registro anterior à atualização)' %><br>
                                        <strong>Data/hora:</strong> <%= item.descartado_em ? new Date(item.descartado_em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : 'Não registrada' %><br>
                                        <strong>ID do responsável:</strong> <%= item.descartado_por || 'Não registrado' %>
                                    </small>
                                </details>
                            <% } %>
                        </td>
                        <td class="acoes">
                            <% if (usuario && usuario.administrador && !['DESCARTADA','TRANSFUNDIDA','RESERVADA'].includes(item.status)) { %>
                                <details>
                                    <summary class="botao botao-perigo botao-pequeno">Descartar</summary>
                                    <form action="/hemocomponentes/descartar/<%= item.id %>" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                                        <label for="motivo-descarte-<%= item.id %>">Justificativa obrigatória</label>
                                        <textarea id="motivo-descarte-<%= item.id %>" name="motivo_descarte"
                                                  minlength="10" maxlength="500" rows="3" required
                                                  placeholder="Descreva o motivo do descarte (mínimo 10 caracteres)"></textarea>
                                        <button class="botao botao-perigo botao-pequeno" type="submit">Confirmar descarte</button>
                                    </form>
                                </details>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
                    <tr data-sem-resultado hidden><td colspan="9" class="vazio">Nenhuma bolsa encontrada com esse filtro.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <%- include('../partials/paginacao') %>
</section>

<%- include('../partials/fim') %>