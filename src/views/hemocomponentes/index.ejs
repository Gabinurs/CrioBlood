<%- include('../partials/inicio', { titulo:'Bolsas do lote',subtitulo:'Cadastro e identificação interna das bolsas',ativo:'lotes' }) %>
<% if(locals.cadastrada){ %><div class="alerta alerta-sucesso" role="status">Bolsa cadastrada com sucesso! Código interno CrioBlood: <strong><%= cadastrada %></strong></div><% } %>\n<section class="cabecalho-pagina"><div><h3>Bolsas recebidas</h3><p>Use o código interno CrioBlood para localizar e vincular cada bolsa.</p></div><% if(lote_id){ %><a class="botao" href="/hemocomponentes/novo?lote_id=<%= lote_id %>">+ Adicionar bolsa</a><% }else{ %><a class="botao botao-claro" href="/lotes">Voltar aos lotes</a><% } %></section>
<section class="painel" data-filtravel><div class="filtros"><input type="search" data-filtro-texto placeholder="Buscar código interno, original ou lote"><select data-filtro-campo="status"><option value="">Todos os status</option><% ['EM_CONFERENCIA','DISPONIVEL','RESERVADA','TRANSFUNDIDA','DESCARTADA','VENCIDA'].forEach(s=>{ %><option value="<%= s %>"><%= rot.nomeStatusBolsa(s) %></option><% }) %></select></div>
<div class="tabela-container"><table><thead><tr><th>Código CrioBlood</th><th>Código original</th><th>Lote</th><th>Produto</th><th>ABO/Rh</th><th>Volume</th><th>Validade</th><th>Status</th><th>Ações</th></tr></thead><tbody><% if(!hemocomponentes.length){ %><tr><td colspan="9" class="vazio">Nenhuma bolsa cadastrada.</td></tr><% }else{hemocomponentes.forEach(item=>{ %><tr data-busca="<%= ((item.codigo_interno||'')+' '+item.codigo_original+' '+(item.codigo_lote||'')).toLowerCase() %>" data-status="<%= item.status %>"><td><strong><%= item.codigo_interno %></strong></td><td><%= item.codigo_original %></td><td><%= item.codigo_lote||item.lote_id %></td><td><%= rot.tipo(item.tipo) %></td><td><%= rot.tipagem(item.abo,item.fator_rh) %></td><td><%= item.volume_ml||'—' %> mL</td><td><%= item.data_validade_br %></td><td><%- rot.statusBolsa(item.status) %></td><td class="acoes"><a class="botao botao-claro botao-pequeno" href="/hemocomponentes/editar/<%= item.id %>">Editar</a></td></tr><% }) %><tr data-sem-resultado hidden><td colspan="9" class="vazio">Nenhuma bolsa encontrada.</td></tr><% } %></tbody></table></div></section><%- include('../partials/fim') %>