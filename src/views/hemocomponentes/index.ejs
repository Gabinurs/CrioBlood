<%- include('../partials/inicio', { titulo: 'Bolsas do lote', subtitulo: 'Cadastro e conferência das bolsas recebidas em um lote', ativo: 'lotes' }) %>

<section class="cabecalho-pagina">
    <div>
        <h3>Bolsas recebidas</h3>
        <p>As bolsas são cadastradas dentro de um lote aberto. Selecione um lote para consultar ou adicionar bolsas.</p>
    </div>
    <% if (typeof lote_id !== 'undefined' && lote_id) { %>
        <a class="botao" href="/hemocomponentes/novo?lote_id=<%= lote_id %>">+ Adicionar bolsa a este lote</a>
    <% } else { %>
        <a class="botao botao-claro" href="/lotes">Voltar aos lotes</a>
    <% } %>
</section>

<section class="painel" data-filtravel>
    <div class="filtros">
        <input type="search" data-filtro-texto placeholder="Buscar por código ou lote..." aria-label="Buscar bolsa">
        <select data-filtro-campo="status" aria-label="Filtrar por status">
            <option value="">Todos os status</option>
            <% ['EM_CONFERENCIA', 'DISPONIVEL', 'RESERVADA', 'TRANSFUNDIDA', 'DESCARTADA', 'VENCIDA'].forEach(function (s) { %>
                <option value="<%= s %>"><%= rot.nomeStatusBolsa(s) %></option>
            <% }) %>
        </select>
    </div>

    <div class="tabela-container">
        <table>
            <thead>
                <tr><th>ID</th><th>Código</th><th>Lote</th><th>Produto</th><th>ABO/Rh</th><th>Validade</th><th>Status</th><th>Ações</th></tr>
            </thead>
            <tbody>
                <% if (!hemocomponentes || hemocomponentes.length === 0) { %>
                    <tr><td colspan="8" class="vazio">Nenhum registro encontrado.</td></tr>
                <% } else { hemocomponentes.forEach(function (item) { %>
                    <tr data-busca="<%= ((item.codigo_original || '') + ' ' + (item.codigo_lote || '')).toLowerCase() %>" data-status="<%= item.status %>">
                        <td><%= item.id %></td>
                        <td><strong><%= item.codigo_original %></strong></td>
                        <td><%= item.codigo_lote || item.lote_id %></td>
                        <td><%= item.tipo %></td>
                        <td><%= rot.tipagem(item.abo, item.fator_rh) %></td>
                        <td><%= item.data_validade_br %></td>
                        <td><%- rot.statusBolsa(item.status) %></td>
                        <td class="acoes">
                            <a class="botao botao-claro botao-pequeno" href="/hemocomponentes/editar/<%= item.id %>">Editar</a>
                            <% if (item.status !== 'DESCARTADA' && item.status !== 'TRANSFUNDIDA' && item.status !== 'RESERVADA') { %>
                                <form action="/hemocomponentes/descartar/<%= item.id %>" method="POST"
                                      data-confirmar="ATENÇÃO: o descarte não pode ser desfeito. Confirmar?">
                                    <button class="botao botao-perigo botao-pequeno" type="submit">Descartar</button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
                    <tr data-sem-resultado hidden><td colspan="8" class="vazio">Nenhum registro encontrado com esse filtro.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>

<%- include('../partials/fim') %>
