<%- include('../partials/inicio', { titulo: 'Cadastrar hemocomponente', subtitulo: 'Identificação, conferência e entrada da bolsa no estoque', ativo: 'hemocomponentes' }) %>

<section class="painel formulario cadastro-bolsa">
    <div class="bolsa-aviso">
        <span class="bolsa-aviso-icone">✓</span>
        <div><strong>Identificação CrioBlood</strong><p>O código original do hemocentro fornecedor será mantido. Um código interno exclusivo será gerado automaticamente após salvar.</p></div>
    </div>

    <form action="/hemocomponentes/novo" method="POST" id="form-cadastro-bolsa">
        <section class="bolsa-secao">
            <div class="bolsa-secao-titulo"><span>01</span><div><h3>Identificação da bolsa</h3><p>Informe a origem e os dados do hemocomponente.</p></div></div>
            <div class="bolsa-campos">
                <div class="campo"><label for="lote_id">Lote de recebimento *</label><input type="number" id="lote_id" name="lote_id" min="1" value="<%= locals.lote_id||'' %>" required><small>O lote precisa estar aberto.</small></div>
                <div class="campo"><label for="codigo_original">Código original da bolsa *</label><input type="text" id="codigo_original" name="codigo_original" maxlength="50" placeholder="Ex.: B345326011725601" required></div>
                <div class="campo"><label for="tipo">Hemocomponente *</label><select id="tipo" name="tipo" required><option value="">Selecione...</option><% ['CH','PLASMA','PLAQUETAS','CRIO'].forEach(function(t){ %><option value="<%= t %>"><%= rot.tipo(t) %></option><% }) %></select></div>
                <div class="campo"><label for="volume_ml">Volume (mL) *</label><input type="number" id="volume_ml" name="volume_ml" min="1" max="5000" step="1" placeholder="Ex.: 288" required></div>
            </div>
        </section>

        <section class="bolsa-secao">
            <div class="bolsa-secao-titulo"><span>02</span><div><h3>Tipagem sanguínea</h3><p>Confirme os dados ABO e Rh conforme a etiqueta original.</p></div></div>
            <div class="bolsa-campos bolsa-campos-curtos">
                <div class="campo"><label for="abo">Grupo ABO *</label><select id="abo" name="abo" required><option value="">Selecione...</option><% ['A','B','AB','O'].forEach(function(o){ %><option value="<%= o %>"><%= o %></option><% }) %></select></div>
                <div class="campo"><label for="fator_rh">Fator Rh *</label><select id="fator_rh" name="fator_rh" required><option value="">Selecione...</option><option value="+">Positivo (+)</option><option value="-">Negativo (-)</option></select></div>
            </div>
            <label class="bolsa-confirmacao"><input type="checkbox" name="tipagem_confirmada" required><span><strong>Tipagem ABO/Rh conferida</strong><small>Confirmo que o grupo ABO e o fator Rh foram verificados na identificação da bolsa.</small></span></label>
        </section>

        <section class="bolsa-secao">
            <div class="bolsa-secao-titulo"><span>03</span><div><h3>Coleta e validade</h3><p>A validade será calculada automaticamente pelo tipo de hemocomponente.</p></div></div>
            <div class="bolsa-campos bolsa-campos-curtos">
                <div class="campo"><label for="data_coleta">Data da coleta *</label><input type="date" id="data_coleta" name="data_coleta" required></div>
                <div class="campo"><label for="data_validade">Data de validade *</label><input type="date" id="data_validade" name="data_validade" required><small id="ajuda-validade">Selecione o hemocomponente e a data da coleta.</small></div>
            </div>
            <div class="bolsa-regra-validade" id="regra-validade">Prazo aplicado: aguardando seleção do hemocomponente.</div>
        </section>

        <section class="bolsa-secao">
            <div class="bolsa-secao-titulo"><span>04</span><div><h3>Exames realizados</h3><p>Marque somente os exames que constam como realizados na documentação da bolsa.</p></div></div>
            <div class="bolsa-exames-cabecalho"><span class="bolsa-exames-contador" id="contador-exames">0 de 13 selecionados</span><button type="button" class="botao botao-claro bolsa-marcar-todos" data-marcar-exames>Marcar todos</button></div>
            <div class="bolsa-exames-grade">
                <% [['anti_hbc','Anti-HBc'],['anti_hcv','Anti-HCV'],['anti_hiv_1_2','Anti-HIV 1/2'],['anti_htlv_i_ii','Anti-HTLV I/II'],['chagas','Chagas'],['hbsag','HBsAg'],['nat_hbv','NAT HBV'],['nat_hcv','NAT HCV'],['nat_hiv','NAT HIV'],['nat_malaria','NAT Malária'],['sifilis','Sífilis'],['pesquisa_hbs','Pesquisa HbS — ausente'],['pai_negativo','PAI — negativo']].forEach(function(e){ %>
                <label class="bolsa-exame"><input type="checkbox" name="<%= e[0] %>" data-exame-bolsa><span><%= e[1] %></span></label>
                <% }) %>
            </div>
        </section>

        <section class="bolsa-secao">
            <div class="bolsa-secao-titulo"><span>05</span><div><h3>Conferência de recebimento</h3><p>Confirme as condições físicas da bolsa antes de liberar a entrada.</p></div></div>
            <div class="bolsa-conferencias">
                <label class="bolsa-confirmacao"><input type="checkbox" name="inspecao_visual" required><span><strong>Inspeção visual realizada</strong><small>Aspecto e condições gerais verificados.</small></span></label>
                <label class="bolsa-confirmacao"><input type="checkbox" name="integridade_confirmada" required><span><strong>Integridade confirmada</strong><small>Bolsa e equipo sem sinais de violação ou vazamento.</small></span></label>
            </div>
            <div class="campo bolsa-status"><label for="status">Status inicial</label><select id="status" name="status"><option value="EM_CONFERENCIA">Em conferência</option><option value="DISPONIVEL">Disponível (exige todas as confirmações)</option></select></div>
            <div class="campo bolsa-observacoes"><label for="observacoes">Observações</label><textarea id="observacoes" name="observacoes" rows="3" placeholder="Informações adicionais sobre o recebimento..."></textarea></div>
        </section>

        <div class="rodape-form bolsa-rodape"><a class="botao botao-claro" href="/lotes">Cancelar</a><button class="botao" type="submit">Salvar bolsa e gerar etiqueta</button></div>
    </form>
</section>
<%- include('../partials/fim') %>