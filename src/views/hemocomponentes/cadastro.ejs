<%- include('../partials/inicio', { titulo: 'Adicionar bolsa ao recebimento', subtitulo: 'Inclua uma bolsa no lote aberto e mantenha o recebimento agrupado', ativo: 'recebimento' }) %>
<section class="painel formulario">
    <div class="alerta alerta-info"><strong>Identificação CrioBlood:</strong> o código original será preservado e um código local exclusivo será gerado automaticamente.</div>
    <form action="/hemocomponentes/novo" method="POST">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <div class="grade-form">
            <% if (locals.loteSelecionado) { %>
            <div class="campo largo lote-contexto-cadastro">
                <span class="recebimento-etiqueta">ADICIONANDO AO LOTE</span>
                <strong><%= loteSelecionado.codigo %></strong>
                <small><%= loteSelecionado.data_br %> · Somente este lote receberá a bolsa.</small>
                <input type="hidden" id="lote_id" name="lote_id" value="<%= loteSelecionado.id %>">
            </div>
            <% } else { %>
            <div class="campo"><label for="lote_id">Lote de origem *</label><select id="lote_id" name="lote_id" required><option value="">Selecione um lote aberto</option><% (locals.lotes||[]).forEach(function(l){ %><option value="<%= l.id %>" <%= String(l.id)===String(locals.lote_id)?'selected':'' %>><%= l.codigo %> · <%= l.data_br %></option><% }) %></select><small>Somente lotes abertos recebem novas bolsas. O ideal é iniciar pelo módulo Recebimento de bolsas.</small></div>
            <% } %>
            <div class="campo"><label for="codigo_original">Código original da bolsa *</label><input id="codigo_original" name="codigo_original" maxlength="<%= padroes.codigoBolsa.max %>" pattern="<%= padroes.codigoBolsa.fonte %>" title="<%= padroes.codigoBolsa.mensagem %>" required></div>
            <div class="campo"><label for="tipo">Hemocomponente *</label><select id="tipo" name="tipo" required><option value="">Selecione</option><% ['CH','PLASMA','PLAQUETAS','CRIO'].forEach(function(t){ %><option value="<%= t %>"><%= rot.tipo(t) %></option><% }) %></select></div>
            <div class="campo"><label for="volume_ml">Volume (mL) *</label><input type="number" id="volume_ml" name="volume_ml" min="1" max="5000" step="1" required></div>
            <div class="campo"><label for="abo">Grupo ABO *</label><select id="abo" name="abo" required><option value="">Selecione</option><% ['A','B','AB','O'].forEach(function(o){ %><option value="<%= o %>"><%= o %></option><% }) %></select></div>
            <div class="campo"><label for="fator_rh">Fator Rh *</label><select id="fator_rh" name="fator_rh" required><option value="">Selecione</option><option value="+">Positivo (+)</option><option value="-">Negativo (-)</option></select></div>
            <div class="campo"><label for="data_coleta">Data da coleta *</label><input type="date" id="data_coleta" name="data_coleta" required><small>Preenchida automaticamente com a data de hoje. Você pode alterar para a data real da coleta.</small></div>
            <div class="campo"><label for="data_validade">Validade calculada automaticamente</label><input type="date" id="data_validade" readonly aria-readonly="true" tabindex="-1"><small id="ajuda-validade">CH: 42 dias; plaquetas: 7 dias; plasma e crio: 1 ano. A validade é calculada pelo sistema.</small></div>
            <div class="campo largo"><h3>Exames realizados</h3><p class="descricao">Marque os exames que constam na documentação da bolsa.</p>
                <div class="bolsa-exames-cabecalho"><span class="bolsa-exames-contador" id="contador-exames">0 de 13 selecionados</span><span class="texto-secundario">Selecione somente os exames registrados no documento da bolsa.</span></div>
                <div class="marcas bolsa-exames-grade">
                <% [['anti_hbc','Anti-HBc'],['anti_hcv','Anti-HCV'],['anti_hiv_1_2','Anti-HIV 1/2'],['anti_htlv_i_ii','Anti-HTLV I/II'],['chagas','Chagas'],['hbsag','HBsAg'],['nat_hbv','NAT HBV'],['nat_hcv','NAT HCV'],['nat_hiv','NAT HIV'],['nat_malaria','NAT Malária'],['sifilis','Sífilis'],['pesquisa_hbs','HbS ausente'],['pai_negativo','PAI negativo']].forEach(function(e){ %><label class="marca"><input type="checkbox" name="<%= e[0] %>" data-exame><%= e[1] %></label><% }) %>
                </div>
                <button type="button" class="botao botao-claro" id="marcar-exames">Marcar todos</button>
            </div>
            <div class="campo largo marcas">
                <label class="marca"><input type="checkbox" name="inspecao_visual" required> Inspeção visual realizada</label>
                <label class="marca"><input type="checkbox" name="integridade_confirmada" required> Integridade da bolsa confirmada</label>
                <label class="marca"><input type="checkbox" name="tipagem_confirmada" required> Tipagem ABO/Rh conferida</label>
            </div>
            <div class="campo largo"><label for="status">Status inicial</label><select id="status" name="status"><option value="EM_CONFERENCIA">Em conferência</option><option value="DISPONIVEL">Disponível (exige todas as confirmações)</option></select></div>
            <div class="campo largo"><label for="observacoes">Observações</label><textarea id="observacoes" name="observacoes" data-contador="500" rows="3"></textarea></div>
        </div>
        <div class="rodape-form"><button class="botao" type="submit">Salvar bolsa</button><a class="botao botao-claro" href="/lotes">Voltar ao recebimento</a></div>
    </form>
</section>
<script src="/js/hemocomponente-cadastro.js" defer></script>
<%- include('../partials/fim') %>