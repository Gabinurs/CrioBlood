<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title>Etiqueta CrioBlood</title><style>*{box-sizing:border-box}body{font-family:Arial;margin:0;padding:22px;background:#f3f5f8;color:#172b45}.actions{max-width:760px;margin:0 auto 12px}.actions button,.actions a{padding:10px 15px;background:#102943;color:white;border:0;border-radius:6px;text-decoration:none}.label{max-width:760px;margin:auto;background:white;border:2px solid #263746;padding:18px}.head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #888;padding-bottom:10px}.hospital{text-align:center;font-weight:bold;flex:1}.blood{font-size:34px;font-weight:900}.internal{font:900 26px monospace;letter-spacing:2px;text-align:center;border:1px dashed #444;padding:10px;margin:12px 0}.orig{font-size:12px}.product{font-size:20px;font-weight:bold;margin-top:10px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}.grid div{border-bottom:1px solid #ddd;padding:5px}.grid small{display:block;color:#536273;font-size:10px;text-transform:uppercase}.tests{border-top:1px solid #888;padding-top:10px;font-size:11px;line-height:1.7}.foot{border-top:1px solid #888;padding-top:8px;font-size:10px}@media print{body{padding:0;background:white}.actions{display:none}.label{max-width:none;border:1px solid #222}@page{size:100mm 75mm;margin:4mm}}</style></head><body><div class="actions"><button onclick="window.print()">Imprimir etiqueta</button> <a href="/hemocomponentes?lote_id=<%= hemocomponente.lote_id %>">Voltar ao lote</a></div><article class="label"><header class="head"><div class="hospital">SANTA CASA DE MISERICÓRDIA DE CRUZEIRO</div><div class="blood"><%= hemocomponente.abo||'—' %><%= hemocomponente.fator_rh||'' %></div></header><div class="internal"><%= hemocomponente.codigo_interno %></div><div class="orig">Código original do fornecedor: <strong><%= hemocomponente.codigo_original %></strong></div><div class="product"><%= rot.tipo(hemocomponente.tipo) %> · <%= hemocomponente.volume_ml||'—' %> mL</div><div class="grid"><div><small>Código interno</small><strong><%= hemocomponente.codigo_interno %></strong></div><div><small>ABO/Rh</small><strong><%= rot.tipagem(hemocomponente.abo,hemocomponente.fator_rh) %></strong></div><div><small>Data da coleta</small><strong><%= hemocomponente.data_coleta_br %></strong></div><div><small>Vencimento</small><strong><%= hemocomponente.data_validade_br %></strong></div><div><small>Lote</small><strong><%= hemocomponente.lote_id %></strong></div><div><small>Volume</small><strong><%= hemocomponente.volume_ml||'—' %> mL</strong></div></div><div class="tests"><strong>EXAMES REGISTRADOS</strong><br><% const ex=[['anti_hbc','Anti-HBc'],['anti_hcv','Anti-HCV'],['anti_hiv_1_2','Anti-HIV 1/2'],['anti_htlv_i_ii','Anti-HTLV I/II'],['chagas','Chagas'],['hbsag','HBsAg'],['nat_hbv','NAT HBV'],['nat_hcv','NAT HCV'],['nat_hiv','NAT HIV'],['nat_malaria','NAT Malária'],['sifilis','Sífilis'],['pesquisa_hbs','Pesquisa HbS ausente'],['pai_negativo','PAI negativo']];ex.forEach((e,i)=>{ %><%= e[1] %>: <strong><%= hemocomponente[e[0]]?'Conferido':'Não marcado' %></strong><%= i===ex.length-1?'':' · ' %><% }) %></div><p class="foot">Etiqueta interna de identificação. Conferir sempre a identificação original e os registros oficiais antes de qualquer procedimento.</p></article></body></html>