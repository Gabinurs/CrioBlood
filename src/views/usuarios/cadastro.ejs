<% var val = locals.valores || {}; %>
<%- include('../partials/inicio', { titulo: 'Cadastrar usuário', subtitulo: 'Nova conta de acesso ao sistema', ativo: 'usuarios' }) %>

<section class="painel formulario">
    <div class="alerta alerta-info">
        Cadastre cada colaborador com sua função profissional. O nome e a função serão identificados automaticamente nas conferências.
    </div>

    <form action="/usuarios" method="POST">
        <div class="grade-form">
            <div class="campo largo">
                <label for="nome">Nome completo</label>
                <input type="text" id="nome" name="nome" maxlength="150" autocomplete="name"
                       value="<%= val.nome || '' %>" required>
            </div>

            <div class="campo">
                <label for="login">Nome de usuário (login)</label>
                <input type="text" id="login" name="login" maxlength="80" autocomplete="username"
                       value="<%= val.login || '' %>" required>
            </div>

            <div class="campo largo">
                <label for="funcao">Função profissional *</label>
                <select id="funcao" name="funcao" required>
                    <option value="">Selecione a função...</option>
                    <option value="TECNICO_ENFERMAGEM" <%= val.funcao === 'TECNICO_ENFERMAGEM' ? 'selected' : '' %>>Técnico de enfermagem</option>
                    <option value="TECNICO_LABORATORIO" <%= val.funcao === 'TECNICO_LABORATORIO' ? 'selected' : '' %>>Técnico de laboratório</option>
                    <option value="TECNICO_TRANSFUSAO" <%= val.funcao === 'TECNICO_TRANSFUSAO' ? 'selected' : '' %>>Técnico de transfusão</option>
                    <option value="ENFERMEIRO" <%= val.funcao === 'ENFERMEIRO' ? 'selected' : '' %>>Enfermeiro(a)</option>
                    <option value="BIOMEDICO" <%= val.funcao === 'BIOMEDICO' ? 'selected' : '' %>>Biomédico(a)</option>
                    <option value="MEDICO" <%= val.funcao === 'MEDICO' ? 'selected' : '' %>>Médico(a)</option>
                </select>
            </div>

            <div class="campo">
                <label for="senha">Senha inicial</label>
                <input type="password" id="senha" name="senha" minlength="8" autocomplete="new-password" required>
                <small>Mínimo de 8 caracteres.</small>
            </div>
        </div>

        <div class="rodape-form">
            <button class="botao" type="submit">Cadastrar usuário</button>
            <a class="botao botao-claro" href="/usuarios">Cancelar</a>
        </div>
    </form>
</section>

<%- include('../partials/fim') %>
