<% var val = locals.valores || {}; %>
<%- include('../partials/inicio', { titulo: 'Cadastrar usuário', subtitulo: 'Nova conta de acesso ao sistema', ativo: 'usuarios' }) %>

<section class="painel formulario">
    <div class="alerta alerta-info">
        O novo usuário será criado sem privilégios administrativos. As permissões podem ser configuradas depois.
    </div>

    <form action="/usuarios" method="POST">
        <div class="grade-form">
            <div class="campo largo">
                <label for="nome">Nome completo</label>
                <input type="text" id="nome" name="nome" maxlength="150" autocomplete="name"
                       value="<%= val.nome || '' %>" required>
            </div>

            <div class="campo">
                <label for="login">Nome de usuário (login)</label>
                <input type="text" id="login" name="login" maxlength="80" autocomplete="username"
                       value="<%= val.login || '' %>" required>
            </div>

            <div class="campo">
                <label for="senha">Senha inicial</label>
                <input type="password" id="senha" name="senha" minlength="8" autocomplete="new-password" required>
                <small>Mínimo de 8 caracteres.</small>
            </div>
        </div>

        <div class="rodape-form">
            <button class="botao" type="submit">Cadastrar usuário</button>
            <a class="botao botao-claro" href="/usuarios">Cancelar</a>
        </div>
    </form>
</section>

<%- include('../partials/fim') %>
