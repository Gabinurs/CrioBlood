<% var val = locals.valores || {}; %>
<%- include('../partials/inicio', { titulo: 'Cadastrar usuário', subtitulo: 'Nova conta de acesso ao sistema', ativo: 'usuarios' }) %>

<section class="painel formulario">
    <div class="alerta alerta-info">
        O novo usuário será criado sem privilégios administrativos. As permissões podem ser configuradas depois.
    </div>

    <form action="/usuarios" method="POST">
<input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <div class="grade-form">
            <div class="campo largo">
                <label for="nome">Nome completo</label>
                <input type="text" id="nome" name="nome" maxlength="<%= padroes.nomePessoa.max %>" pattern="<%= padroes.nomePessoa.fonte %>" title="<%= padroes.nomePessoa.mensagem %>" data-mascara="<%= padroes.nomePessoa.mascara %>" autocomplete="name" autocomplete="name"
                       value="<%= val.nome || '' %>" required>
            </div>

            <div class="campo">
                <label for="login">Nome de usuário (login)</label>
                <input type="text" id="login" name="login" maxlength="<%= padroes.login.max %>" pattern="<%= padroes.login.fonte %>" title="<%= padroes.login.mensagem %>" data-mascara="<%= padroes.login.mascara %>" autocomplete="username" spellcheck="false" autocomplete="username"
                       value="<%= val.login || '' %>" required>
            </div>

            <div class="campo">
                <label for="senha">Senha inicial</label>
                <input type="password" id="senha" name="senha" minlength="8" maxlength="<%= padroes.senha.max %>" pattern="<%= padroes.senha.fonte %>" title="<%= padroes.senha.mensagem %>" autocomplete="new-password" required>
                <small>Mínimo de 8 caracteres.</small>
            </div>
        </div>

        <div class="rodape-form">
            <button class="botao" type="submit">Cadastrar usuário</button>
            <a class="botao botao-claro" href="/usuarios">Cancelar</a>
        </div>
    </form>
</section>

<%- include('../partials/fim') %>
