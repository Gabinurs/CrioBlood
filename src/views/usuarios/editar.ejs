<%- include('../partials/inicio', { titulo: 'Editar usuário', subtitulo: 'Código do usuário: ' + usuarioAlvo.id, ativo: 'usuarios' }) %>

<section class="painel formulario">
    <form action="/usuarios/<%= usuarioAlvo.id %>/editar" method="POST">
        <div class="grade-form">
            <div class="campo largo">
                <label for="nome">Nome completo</label>
                <input type="text" id="nome" name="nome" maxlength="150" value="<%= usuarioAlvo.nome %>" required>
            </div>

            <div class="campo largo">
                <label for="login">Login</label>
                <input type="text" id="login" name="login" maxlength="80" value="<%= usuarioAlvo.login %>" required>
            </div>
        </div>

        <div class="rodape-form">
            <button class="botao" type="submit">Salvar alterações</button>
            <a class="botao botao-claro" href="/usuarios">Cancelar</a>
        </div>
    </form>
</section>

<%- include('../partials/fim') %>
