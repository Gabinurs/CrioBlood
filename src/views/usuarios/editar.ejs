<%- include('../partials/inicio', { titulo: 'Editar usuário', subtitulo: 'Código do usuário: ' + usuarioAlvo.id, ativo: 'usuarios' }) %>

<section class="painel formulario">
    <form action="/usuarios/<%= usuarioAlvo.id %>/editar" method="POST">
        <div class="grade-form">
            <div class="campo largo">
                <label for="nome">Nome completo</label>
                <input type="text" id="nome" name="nome" maxlength="150" value="<%= usuarioAlvo.nome %>" required>
            </div>

            <div class="campo largo">
                <label for="funcao">Função profissional *</label>
                <select id="funcao" name="funcao" required>
                    <option value="">Selecione a função...</option>
                    <option value="TECNICO_ENFERMAGEM" <%= usuarioAlvo.funcao === 'TECNICO_ENFERMAGEM' ? 'selected' : '' %>>Técnico de enfermagem</option>
                    <option value="TECNICO_LABORATORIO" <%= usuarioAlvo.funcao === 'TECNICO_LABORATORIO' ? 'selected' : '' %>>Técnico de laboratório</option>
                    <option value="TECNICO_TRANSFUSAO" <%= usuarioAlvo.funcao === 'TECNICO_TRANSFUSAO' ? 'selected' : '' %>>Técnico de transfusão</option>
                    <option value="ENFERMEIRO" <%= usuarioAlvo.funcao === 'ENFERMEIRO' ? 'selected' : '' %>>Enfermeiro(a)</option>
                    <option value="BIOMEDICO" <%= usuarioAlvo.funcao === 'BIOMEDICO' ? 'selected' : '' %>>Biomédico(a)</option>
                    <option value="MEDICO" <%= usuarioAlvo.funcao === 'MEDICO' ? 'selected' : '' %>>Médico(a)</option>
                </select>
            </div>

            <div class="campo largo">
                <label for="login">Login</label>
                <input type="text" id="login" name="login" maxlength="80" value="<%= usuarioAlvo.login %>" required>
            </div>
        </div>

        <div class="rodape-form">
            <button class="botao" type="submit">Salvar alterações</button>
            <a class="botao botao-claro" href="/usuarios">Cancelar</a>
        </div>
    </form>
</section>

<%- include('../partials/fim') %>
