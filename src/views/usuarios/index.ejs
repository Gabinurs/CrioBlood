<%- include('../partials/inicio', { titulo: 'Usuários', subtitulo: 'Contas de acesso ao sistema', ativo: 'usuarios' }) %>

<section class="cabecalho-pagina">
    <div>
        <h3>Gerenciamento de usuários</h3>
        <p>Consulte os usuários e gerencie seus dados, permissões e status. Disponível somente para administradores.</p>
    </div>
    <a class="botao" href="/usuarios/novo">+ Cadastrar usuário</a>
</section>

<section class="painel" data-filtravel>
    <div class="filtros">
        <input type="search" data-filtro-texto placeholder="Buscar por nome ou login..." aria-label="Buscar usuário">
        <select data-filtro-campo="situacao" aria-label="Filtrar por situação">
            <option value="">Todos</option>
            <option value="ativo">Ativos</option>
            <option value="inativo">Inativos</option>
        </select>
    </div>

    <div class="tabela-container">
        <table>
            <thead>
                <tr><th>ID</th><th>Nome</th><th>Login</th><th>Perfil</th><th>Status</th><th>Ações</th></tr>
            </thead>
            <tbody>
                <% if (usuarios.length === 0) { %>
                    <tr><td colspan="6" class="vazio">Nenhum usuário cadastrado.</td></tr>
                <% } else { usuarios.forEach(function (item) { %>
                    <tr data-busca="<%= (item.nome + ' ' + item.login).toLowerCase() %>" data-situacao="<%= item.ativo ? 'ativo' : 'inativo' %>">
                        <td><%= item.id %></td>
                        <td><strong><%= item.nome %></strong></td>
                        <td><%= item.login %></td>
                        <td><span class="status <%= item.administrador ? 's-azul' : 's-cinza' %>"><%= item.administrador ? 'Administrador' : 'Usuário' %></span></td>
                        <td><span class="status <%= item.ativo ? 's-verde' : 's-cinza' %>"><%= item.ativo ? 'Ativo' : 'Inativo' %></span></td>
                        <td class="acoes">
                            <a class="botao botao-claro botao-pequeno" href="/usuarios/<%= item.id %>/editar">Editar</a>
                            <a class="botao botao-claro botao-pequeno" href="/usuarios/<%= item.id %>/permissoes">Permissões</a>

                            <% if (Number(usuario.id) !== Number(item.id)) { %>
                                <form action="/usuarios/<%= item.id %>/status" method="POST"
                                      data-confirmar="Deseja realmente <%= item.ativo ? 'desativar' : 'ativar' %> este usuário?">
                                    <% if (item.ativo) { %>
                                        <button type="submit" class="botao botao-perigo botao-pequeno">Desativar</button>
                                    <% } else { %>
                                        <button type="submit" class="botao botao-ok botao-pequeno">Ativar</button>
                                    <% } %>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
                    <tr data-sem-resultado hidden><td colspan="6" class="vazio">Nenhum usuário encontrado com esse filtro.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>

<%- include('../partials/fim') %>
