<%- include('../partials/inicio', { titulo: 'Permissões', subtitulo: usuarioAlvo.nome + ' (' + usuarioAlvo.login + ')', ativo: 'usuarios' }) %>

<%
const gruposPermissoes = [
    { titulo: 'Recebimento de bolsas e lotes', prefixos: ['lotes.', 'bolsas.'] },
    { titulo: 'Estoque e equipamentos', prefixos: ['estoque.', 'equipamentos.'] },
    { titulo: 'Receptores e amostras', prefixos: ['pacientes.', 'amostras.'] },
    { titulo: 'Solicitações transfusionais', prefixos: ['solicitacoes.'] },
    { titulo: 'Compatibilidade', prefixos: ['compatibilidade.'] },
    { titulo: 'Transfusões', prefixos: ['transfusoes.'] },
    { titulo: 'Relatórios', prefixos: ['relatorios.'] },
    { titulo: 'Administração de usuários', prefixos: ['usuarios.'] }
];
const codigosLegados = new Set([
    'pacientes.gerenciar', 'lotes.gerenciar', 'bolsas.gerenciar',
    'estoque.gerenciar', 'solicitacoes.gerenciar'
]);
%>

<section class="painel formulario">
    <h3>Gerenciar permissões</h3>
    <p class="descricao">Marque individualmente o que esta conta poderá visualizar ou executar. Administradores mantêm acesso completo.</p>

    <form action="/usuarios/<%= usuarioAlvo.id %>/permissoes" method="POST">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

        <% gruposPermissoes.forEach(function (grupo) {
            const itens = permissoes.filter(function (p) {
                return !codigosLegados.has(p.codigo) &&
                    grupo.prefixos.some(function (prefixo) { return p.codigo.startsWith(prefixo); });
            });
            if (itens.length) { %>
                <section class="painel" style="margin-top:18px; padding:16px;">
                    <h3><%= grupo.titulo %></h3>
                    <div class="marcas">
                        <% itens.forEach(function (permissao) { %>
                            <label class="marca">
                                <input type="checkbox" name="permissoes" value="<%= permissao.id %>"
                                    <%= idsSelecionados.includes(permissao.id) ? 'checked' : '' %>>
                                <span>
                                    <strong><%= permissao.descricao %></strong>
                                    <small style="color:var(--cinza); margin-left:6px;"><%= permissao.codigo %></small>
                                </span>
                            </label>
                        <% }); %>
                    </div>
                </section>
        <% } }); %>

        <div class="rodape-form">
            <button class="botao" type="submit">Salvar permissões</button>
            <a class="botao botao-claro" href="/usuarios">Voltar</a>
        </div>
    </form>
</section>

<%- include('../partials/fim') %>
