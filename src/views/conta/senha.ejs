<%- include('../partials/inicio', { titulo: titulo, subtitulo: locals.subtitulo || 'Use uma senha com pelo menos 8 caracteres', ativo: locals.pedirAtual ? '' : 'usuarios' }) %>

<section class="painel formulario">
    <form action="<%= acao %>" method="POST" autocomplete="off">
        <div class="grade-form">
            <% if (pedirAtual) { %>
            <div class="campo largo">
                <label for="senha_atual">Senha atual</label>
                <input type="password" id="senha_atual" name="senha_atual" autocomplete="current-password" required>
            </div>
            <% } %>
            <div class="campo">
                <label for="nova_senha">Nova senha</label>
                <input type="password" id="nova_senha" name="nova_senha" minlength="8" maxlength="72" autocomplete="new-password" required>
            </div>
            <div class="campo">
                <label for="confirmacao">Confirmar nova senha</label>
                <input type="password" id="confirmacao" name="confirmacao" minlength="8" maxlength="72" autocomplete="new-password" required>
            </div>
        </div>

        <div class="rodape-form">
            <button class="botao" type="submit">Salvar senha</button>
            <a class="botao botao-claro" href="<%= voltar %>">Cancelar</a>
        </div>
    </form>
</section>

<%- include('../partials/fim') %>
