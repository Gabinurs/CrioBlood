<%- include('../partials/inicio', { titulo: 'Recebimento de bolsas', subtitulo: 'Abertura de lote, inclusão, conferência e finalização', ativo: 'recebimento' }) %>

<section class="cabecalho-pagina recebimento-cabecalho">
    <div>
        <span class="recebimento-etiqueta">FLUXO INTEGRADO</span>
        <h3>Recebimento de bolsas</h3>
        <p>Abra um lote, adicione todas as bolsas recebidas, confira os registros e finalize o recebimento com o comprovante em PDF.</p>
    </div>
    <% if (locals.pode && locals.pode('lotes.gerenciar')) { %>
        <form action="/lotes" method="POST" class="form-abrir-lote">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <label for="origem-lote">Origem do recebimento</label>
            <input id="origem-lote" name="origem" type="text" maxlength="100" required
                   placeholder="Ex.: Hemocentro Regional de Taubaté">
            <button class="botao" type="submit">＋ Abrir novo lote</button>
        </form>
    <% } %>
</section>

<section class="recebimento-etapas">
    <div class="recebimento-etapa"><span>1</span><div><strong>Abrir lote</strong><small>Identifique o recebimento</small></div></div>
    <div class="recebimento-etapa"><span>2</span><div><strong>Adicionar bolsas</strong><small>Cadastre uma ou várias</small></div></div>
    <div class="recebimento-etapa"><span>3</span><div><strong>Conferir</strong><small>Valide cada bolsa</small></div></div>
    <div class="recebimento-etapa"><span>4</span><div><strong>Finalizar</strong><small>Gerar comprovante PDF</small></div></div>
</section>

<section class="indicadores">
    <div class="indicador destaque-amarelo">
        <strong><%= lotes.filter(function (l) { return l.status === 'ABERTO'; }).length %></strong>
        <span>Lotes abertos</span>
    </div>
    <div class="indicador destaque-verde">
        <strong><%= lotes.filter(function (l) { return l.status === 'FECHADO'; }).length %></strong>
        <span>Lotes finalizados</span>
    </div>
    <div class="indicador destaque-azul">
        <strong><%= lotes.reduce(function (total, l) { return total + Number(l.quantidade_bolsas || 0); }, 0) %></strong>
        <span>Bolsas recebidas</span>
    </div>
</section>

<section class="painel recebimento-historico" data-filtravel>
    <div class="cabecalho-pagina recebimento-lista-titulo">
        <div>
            <h3>Histórico de recebimentos</h3>
            <p class="descricao">Cada lote agrupa as bolsas que chegaram no mesmo recebimento.</p>
        </div>
    </div>

    <div class="filtros">
        <input type="search" data-filtro-texto placeholder="Buscar pelo código do lote..." aria-label="Buscar lote">
        <select data-filtro-campo="status" aria-label="Filtrar por situação">
            <option value="">Todos os lotes</option>
            <option value="ABERTO">Em andamento</option>
            <option value="FECHADO">Finalizados</option>
        </select>
    </div>

    <div class="tabela-container">
        <table>
            <thead>
                <tr><th>Lote</th><th>Data/hora de abertura</th><th>Origem</th><th>Bolsas</th><th>Em conferência</th><th>Situação</th><th>Etapas</th></tr>
            </thead>
            <tbody>
                <% if (!lotes.length) { %>
                    <tr><td colspan="7" class="vazio">Nenhum recebimento registrado.<br>Use “Abrir novo lote” para iniciar o primeiro recebimento.</td></tr>
                <% } else { lotes.forEach(function (lote) { %>
                    <tr data-busca="<%= String(lote.codigo || '').toLowerCase() %>" data-status="<%= lote.status %>">
                        <td><strong class="codigo-lote"><%= lote.codigo %></strong><small class="recebimento-responsavel">Responsável: <%= lote.responsavel_abertura || 'Não informado' %></small></td>
                        <td><%= new Date(lote.data_recebimento).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></td>
                        <td><%= lote.origem || 'Não informada' %></td>
                        <td><strong><%= lote.quantidade_bolsas %></strong></td>
                        <td><%= lote.em_conferencia %></td>
                        <td><span class="status <%= lote.status === 'ABERTO' ? 'aberto' : 'fechado' %>"><%= lote.status === 'ABERTO' ? 'Em andamento' : 'Finalizado' %></span></td>
                        <td class="acoes acoes-recebimento">
                            <% if (locals.pode && locals.pode('bolsas.gerenciar')) { %>
                                <a class="botao botao-claro botao-pequeno" href="/hemocomponentes?lote_id=<%= lote.id %>">Conferir bolsas</a>
                                <% if (lote.status === 'ABERTO') { %>
                                    <a class="botao botao-pequeno" href="/hemocomponentes/novo?lote_id=<%= lote.id %>">＋ Adicionar bolsa</a>
                                <% } %>
                            <% } %>
                            <% if (lote.quantidade_bolsas > 0) { %>
                                <a class="botao botao-claro botao-pequeno" href="/lotes/<%= lote.id %>/relatorio">Comprovante PDF</a>
                            <% } %>
                            <% if (lote.status === 'ABERTO' && locals.pode && locals.pode('lotes.gerenciar')) { %>
                                <% if (Number(lote.quantidade_bolsas) > 0 && Number(lote.em_conferencia) === 0) { %>
                                    <form action="/lotes/<%= lote.id %>/fechar" method="POST"
                                          data-confirmar="Finalizar o lote <%= lote.codigo %>? Depois de finalizado, ele não aceitará novas bolsas.">
                                        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                                        <button class="botao botao-perigo botao-pequeno" type="submit">Finalizar lote</button>
                                    </form>
                                <% } else { %>
                                    <span class="status s-amarelo recebimento-aviso-finalizacao">
                                        <%= Number(lote.quantidade_bolsas) === 0 ? 'Adicione bolsas' : lote.em_conferencia + ' em conferência' %>
                                    </span>
                                <% } %>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
                    <tr data-sem-resultado hidden><td colspan="7" class="vazio">Nenhum lote encontrado com esse filtro.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <%- include('../partials/paginacao') %>
</section>

<%- include('../partials/fim') %>