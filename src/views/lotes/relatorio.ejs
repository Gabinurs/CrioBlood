<%- include('../partials/inicio', { titulo: 'Relatório de recebimento', subtitulo: 'Comprovante das bolsas cadastradas no lote', ativo: 'lotes' }) %>

<section class="painel relatorio-recebimento">
    <div class="acoes-relatorio">
        <a class="botao botao-claro" href="/lotes">Voltar aos lotes</a>
        <% if (lote.status === 'ABERTO') { %>
            <a class="botao botao-claro" href="/hemocomponentes/novo?lote_id=<%= lote.id %>">+ Adicionar outra bolsa</a>
        <% } %>
        <button class="botao" type="button" onclick="window.print()">Imprimir / Salvar PDF</button>
    </div>

    <header class="relatorio-topo">
        <div>
            <p class="relatorio-marca">CRIOBLOOD · GESTÃO DE HEMOCENTROS</p>
            <h1>Comprovante de recebimento de bolsas</h1>
            <p class="descricao">Registro das bolsas vinculadas ao lote, com identificação original e código interno CrioBlood.</p>
        </div>
        <div class="relatorio-selo">
            <strong><%= lote.codigo %></strong>
            <span>Lote de recebimento</span>
        </div>
    </header>

    <div class="relatorio-dados">
        <div><span>Data e hora do recebimento</span><strong><%= lote.recebido_em_br %></strong></div>
        <div><span>Origem informada</span><strong><%= lote.origem || 'Não informada' %></strong></div>
        <div><span>Responsável pela abertura</span><strong><%= lote.responsavel_abertura %></strong></div>
        <div><span>Situação do lote</span><strong><%= lote.status === 'FECHADO' ? 'Fechado' : 'Aberto' %></strong></div>
    </div>

    <div class="relatorio-resumo">
        <div><strong><%= bolsas.length %></strong><span>Total de bolsas registradas</span></div>
        <% const porTipo = bolsas.reduce(function (acc, bolsa) { acc[bolsa.tipo] = (acc[bolsa.tipo] || 0) + 1; return acc; }, {}); %>
        <% ['CH', 'PLASMA', 'PLAQUETAS', 'CRIO'].forEach(function (tipo) { %>
            <div><strong><%= porTipo[tipo] || 0 %></strong><span><%= rot.tipo(tipo) %></span></div>
        <% }) %>
    </div>

    <h2 class="relatorio-subtitulo">Bolsas adicionadas ao lote</h2>
    <div class="tabela-container">
        <table class="tabela-relatorio">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Código original</th>
                    <th>Código local CrioBlood</th>
                    <th>Componente</th>
                    <th>ABO/Rh</th>
                    <th>Volume</th>
                    <th>Data e hora do cadastro</th>
                    <th>Responsável pelo cadastro</th>
                </tr>
            </thead>
            <tbody>
                <% if (!bolsas.length) { %>
                    <tr><td colspan="8" class="vazio">Nenhuma bolsa foi adicionada a este lote.</td></tr>
                <% } else { bolsas.forEach(function (bolsa, indice) { %>
                    <tr>
                        <td><%= indice + 1 %></td>
                        <td><strong><%= bolsa.codigo_original %></strong></td>
                        <td><strong><%= bolsa.codigo_interno || '—' %></strong></td>
                        <td><%= rot.tipo(bolsa.tipo) %></td>
                        <td><%= rot.tipagem(bolsa.abo, bolsa.fator_rh) %></td>
                        <td><%= bolsa.volume_ml %> mL</td>
                        <td><%= bolsa.cadastrado_em_br %></td>
                        <td><%= bolsa.responsavel_cadastro %></td>
                    </tr>
                <% }) %><% } %>
            </tbody>
        </table>
    </div>

    <footer class="relatorio-rodape">
        <div>
            <strong>Relatório emitido em:</strong>
            <%= new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %>
        </div>
        <div>
            <strong>Emitido por:</strong> <%= usuario ? usuario.nome : 'Usuário autenticado' %>
        </div>
        <p>Este documento apresenta os dados registrados no CrioBlood para o lote identificado acima. Os códigos originais são preservados e os códigos locais são gerados pelo sistema.</p>
    </footer>
</section>

<style>
.relatorio-recebimento { max-width: 1200px; }
.acoes-relatorio { display:flex; justify-content:flex-end; flex-wrap:wrap; gap:10px; margin-bottom:24px; }
.relatorio-topo { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; padding-bottom:22px; border-bottom:2px solid var(--borda); }
.relatorio-marca { color:var(--rosa); font-size:11px; font-weight:800; letter-spacing:.12em; margin-bottom:8px; }
.relatorio-topo h1 { font-size:24px; margin-bottom:7px; }
.relatorio-selo { min-width:190px; padding:15px; border:1px solid var(--borda); border-radius:12px; background:var(--superficie-2); text-align:center; }
.relatorio-selo strong, .relatorio-selo span { display:block; }
.relatorio-selo strong { font-size:16px; }
.relatorio-selo span { margin-top:5px; color:var(--cinza); font-size:11px; }
.relatorio-dados { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin:22px 0; }
.relatorio-dados div, .relatorio-resumo div { padding:13px; border:1px solid var(--borda); border-radius:10px; }
.relatorio-dados span, .relatorio-dados strong, .relatorio-resumo span, .relatorio-resumo strong { display:block; }
.relatorio-dados span, .relatorio-resumo span { color:var(--cinza); font-size:11px; margin-bottom:6px; }
.relatorio-dados strong { font-size:13px; }
.relatorio-resumo { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:12px; margin-bottom:26px; }
.relatorio-resumo strong { font-size:22px; margin-bottom:3px; }
.relatorio-subtitulo { font-size:16px; margin-bottom:10px; }
.tabela-relatorio { white-space:normal; }
.tabela-relatorio th, .tabela-relatorio td { padding:11px 10px; font-size:11px; }
.relatorio-rodape { margin-top:24px; padding-top:16px; border-top:1px solid var(--borda); color:var(--cinza); font-size:11px; line-height:1.6; }
.relatorio-rodape p { margin-top:8px; }
@media (max-width:800px) {
    .relatorio-dados { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .relatorio-resumo { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .relatorio-topo { flex-direction:column; }
}
@page { size:A4 landscape; margin:12mm; }
@media print {
    .acoes-relatorio, footer:not(.relatorio-rodape) { display:none !important; }
    .relatorio-recebimento { max-width:none; margin:0; padding:0; border:0; box-shadow:none; }
    .relatorio-topo h1 { font-size:19px; }
    .relatorio-dados { grid-template-columns:repeat(4,minmax(0,1fr)); }
    .relatorio-resumo { grid-template-columns:repeat(5,minmax(0,1fr)); }
    .tabela-container { overflow:visible; border:0; }
    .tabela-relatorio { white-space:normal; }
    .tabela-relatorio th, .tabela-relatorio td { padding:7px 6px; font-size:9px; }
    .relatorio-rodape { break-inside:avoid; }
}
</style>

<%- include('../partials/fim') %>
