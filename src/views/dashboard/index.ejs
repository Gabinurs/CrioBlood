<%- include('../partials/inicio', { titulo: 'Início', subtitulo: 'Visão geral do hemocentro', ativo: 'inicio' }) %>

<% if (resumo.vencendo > 0) { %>
    <div class="alerta alerta-aviso">
        <strong><%= resumo.vencendo %></strong> bolsa(s) vencem nos próximos 7 dias.
        <a href="/estoque">Ver no estoque</a>.
    </div>
<% } %>

<section class="indicadores">
    <a class="indicador destaque-verde" href="/estoque">
        <strong><%= resumo.disponiveis %></strong><span>Bolsas disponíveis</span>
    </a>
    <a class="indicador destaque-azul" href="/transfusoes">
        <strong><%= resumo.reservadas %></strong><span>Bolsas reservadas</span>
    </a>
    <a class="indicador destaque-amarelo" href="/hemocomponentes?status=EM_CONFERENCIA">
        <strong><%= resumo.em_conferencia %></strong><span>Em conferência</span>
    </a>
    <a class="indicador destaque-vermelho" href="/estoque">
        <strong><%= resumo.vencendo %></strong><span>Vencem em 7 dias</span>
    </a>
    <a class="indicador" href="/solicitacoes">
        <strong><%= contagens.pendentes %></strong><span>Solicitações pendentes</span>
    </a>
    <a class="indicador" href="/transfusoes">
        <strong><%= contagens.aguardando %></strong><span>Aguardando transfusão</span>
    </a>
    <a class="indicador" href="/lotes">
        <strong><%= contagens.lotes_abertos %></strong><span>Lotes abertos</span>
    </a>
    <a class="indicador" href="/relatorios">
        <strong><%= contagens.transfusoes_mes %></strong><span>Transfusões no mês</span>
    </a>
</section>

<section class="grade-2">
    <div class="painel">
        <h3>Estoque disponível por tipo</h3>
        <p class="descricao">Bolsas disponíveis e dentro da validade.</p>
        <% porTipo.forEach(function (t) { %>
            <div class="barra-linha">
                <span><%= rot.tipo(t.tipo) %></span>
                <div class="barra-trilho">
                    <div class="barra-preenchimento" style="width: <%= Math.round((t.total / maiorTipo) * 100) %>%"></div>
                </div>
                <span class="barra-valor"><%= t.total %></span>
            </div>
        <% }) %>
    </div>

    <div class="painel">
        <h3>Disponíveis por tipagem</h3>
        <p class="descricao">Em vermelho: tipagem sem nenhuma bolsa disponível.</p>
        <div class="mapa-tipagem">
            <% porTipagem.forEach(function (t) { %>
                <div class="tipagem <%= t.total === 0 ? 'baixo' : '' %>">
                    <strong><%= t.rotulo %></strong>
                    <span><%= t.total %> bolsa(s)</span>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<section class="grade-2">
    <div class="painel">
        <h3>Próximos vencimentos</h3>
        <div class="tabela-container">
            <table>
                <thead>
                    <tr><th>Código</th><th>Tipo</th><th>ABO/Rh</th><th>Validade</th><th>Prazo</th></tr>
                </thead>
                <tbody>
                    <% if (vencimentos.length === 0) { %>
                        <tr><td colspan="5" class="vazio">Nenhuma bolsa em estoque.</td></tr>
                    <% } else { vencimentos.forEach(function (b) { %>
                        <tr>
                            <td><strong><%= b.codigo_original %></strong></td>
                            <td><%= b.tipo %></td>
                            <td><%= rot.tipagem(b.abo, b.fator_rh) %></td>
                            <td><%= b.validade_br %></td>
                            <td><%- rot.validade(b.dias_restantes) %></td>
                        </tr>
                    <% }) } %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="painel">
        <h3>Solicitações pendentes</h3>
        <div class="tabela-container">
            <table>
                <thead>
                    <tr><th>Paciente</th><th>Produto</th><th>Urgência</th><th></th></tr>
                </thead>
                <tbody>
                    <% if (urgentes.length === 0) { %>
                        <tr><td colspan="4" class="vazio">Nenhuma solicitação pendente.</td></tr>
                    <% } else { urgentes.forEach(function (s) { %>
                        <tr>
                            <td>
                                <strong><%= s.paciente_nome %></strong>
                                <br><small><%= rot.tipagem(s.paciente_abo, s.paciente_rh) %></small>
                            </td>
                            <td><%= s.tipo %></td>
                            <td><%- rot.urgencia(s.urgencia) %></td>
                            <td><a class="botao botao-pequeno" href="/compatibilidade?solicitacao=<%= s.id %>">Buscar bolsa</a></td>
                        </tr>
                    <% }) } %>
                </tbody>
            </table>
        </div>
    </div>
</section>

<section class="painel">
    <h3>Ações rápidas</h3>
    <div class="atalhos">
        <form action="/lotes" method="POST" data-confirmar="Abrir um novo lote de recebimento?">
            <button class="botao" type="submit">+ Abrir lote</button>
        </form>
        <a class="botao botao-claro" href="/hemocomponentes/novo">+ Cadastrar bolsa</a>
        <a class="botao botao-claro" href="/pacientes/novo">+ Novo paciente</a>
        <a class="botao botao-claro" href="/solicitacoes/nova">+ Nova solicitação</a>
        <a class="botao botao-claro" href="/transfusoes">Registrar transfusão</a>
        <a class="botao botao-claro" href="/relatorios">Ver relatórios</a>
    </div>
</section>

<%- include('../partials/fim') %>
