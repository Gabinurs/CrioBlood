<%- include('../partials/inicio', { titulo: 'Receptor', subtitulo: 'Consulta e cadastro de receptores', ativo: 'pacientes' }) %>

<section class="receptor-consulta">
    <div class="painel receptor-busca">
        <div class="receptor-titulo">
            <span class="receptor-icone" aria-hidden="true">⌕</span>
            <div>
                <h3>Consultar receptor</h3>
                <p>Digite o nome completo ou parte do nome para localizar um cadastro.</p>
            </div>
        </div>
        <label class="rotulo-busca" for="busca-receptor">Nome do receptor</label>
        <div class="campo-busca-receptor">
            <input id="busca-receptor" type="search" autocomplete="off"
                placeholder="Ex.: Maria, João, Ana..." aria-label="Buscar receptor pelo nome"
                data-busca-receptor>
            <button type="button" class="botao botao-busca" data-limpar-busca aria-label="Limpar busca">×</button>
        </div>
        <small class="ajuda-busca">A busca encontra todos os receptores que contenham o trecho digitado.</small>
    </div>

    <div class="painel receptor-resultados">
        <div class="receptor-titulo receptor-titulo-lista">
            <span class="receptor-icone" aria-hidden="true">☷</span>
            <div>
                <h3>Receptores encontrados <span class="contador-receptores" data-contador-receptores>0</span></h3>
                <p data-instrucao-busca>Digite um nome acima para exibir os resultados.</p>
            </div>
        </div>

        <div class="tabela-container">
            <table class="tabela-receptores">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Data de nascimento</th>
                        <th>Prontuário</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody data-lista-receptores>
                    <% if (pacientes.length) { pacientes.forEach(function (p) { %>
                        <tr data-receptor-linha
                            data-nome-receptor="<%= p.nome %>"
                            data-situacao-receptor="<%= p.ativo ? 'ativo' : 'inativo' %>"
                            hidden>
                            <td><strong><%= p.nome %></strong></td>
                            <td><%= p.data_nascimento_br %></td>
                            <td><%= p.prontuario || '—' %></td>
                            <td class="acoes acoes-receptor">
                                <a class="botao botao-pequeno botao-claro" href="/pacientes/<%= p.id %>/dossie">Dossiê</a>
                                <a class="botao botao-pequeno" href="/pacientes/<%= p.id %>/amostras/nova">Nova amostra</a>
                                <a class="botao botao-pequeno botao-claro" href="/pacientes/<%= p.id %>/editar">Edição</a>
                                <a class="botao botao-pequeno botao-perigo" href="/solicitacoes/nova?paciente_id=<%= p.id %>&urgencia=EMERGENCIA">Extrema urgência</a>
                            </td>
                             
                        </tr>
                    <% }) } %>
                    <tr data-sem-receptor hidden>
                        <td colspan="4" class="vazio">Nenhum receptor encontrado com esse nome.</td>
                    </tr>
                    <% if (!pacientes.length) { %>
                        <tr><td colspan="4" class="vazio">Ainda não há receptores cadastrados. Use o botão Inserir para cadastrar o primeiro.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="receptor-inserir">
            <div>
                <strong>Não encontrou o receptor?</strong>
                <span>Cadastre um novo receptor no sistema.</span>
            </div>
            <button type="button" class="botao botao-inserir" data-abrir-cadastro>＋ Inserir</button>
        </div>
    </div>
</section>

<div class="modal-receptor" data-modal-receptor <%= abrirCadastro ? '' : 'hidden' %>>
    <div class="modal-fundo" data-fechar-cadastro></div>
    <section class="modal-conteudo" role="dialog" aria-modal="true" aria-labelledby="titulo-modal-receptor">
        <header class="modal-cabecalho">
            <div><span aria-hidden="true">♙</span><h3 id="titulo-modal-receptor">Cadastro de Receptor</h3></div>
            <button type="button" class="modal-fechar" data-fechar-cadastro aria-label="Fechar">×</button>
        </header>

        <form method="POST" action="/pacientes/novo" class="form-receptor-modal">
            <div class="modal-corpo">
                <% if (locals.erro) { %><div class="alerta alerta-erro"><%= erro %></div><% } %>
                <div class="secao-modal">
                    <h4>Dados obrigatórios <span>*</span></h4>
                    <div class="grade-receptor-modal">
                        <div class="campo-receptor campo-receptor-largo">
                            <label for="nome">Nome completo <span>*</span></label>
                            <input type="text" id="nome" name="nome" maxlength="255" required
                                value="<%= valores.nome || '' %>" autocomplete="name">
                        </div>
                        <div class="campo-receptor">
                            <label for="data_nascimento">Data de nascimento <span>*</span></label>
                            <input type="date" id="data_nascimento" name="data_nascimento" required
                                value="<%= valores.data_nascimento || '' %>">
                        </div>
                        <div class="campo-receptor">
                            <label for="nome_mae">Nome da mãe <span>*</span></label>
                            <input type="text" id="nome_mae" name="nome_mae" maxlength="255" required
                                value="<%= valores.nome_mae || '' %>">
                        </div>
                    </div>
                </div>

                <div class="secao-modal">
                    <h4>Demais informações <small>(opcional)</small></h4>
                    <div class="grade-receptor-modal">
                        <div class="campo-receptor">
                            <label for="prontuario">Prontuário</label>
                            <input type="text" id="prontuario" name="prontuario" maxlength="50" value="<%= valores.prontuario || '' %>">
                        </div>
                        <div class="campo-receptor">
                            <label for="cns">CNS</label>
                            <input type="text" id="cns" name="cns" maxlength="20" value="<%= valores.cns || '' %>">
                        </div>
                        <div class="campo-receptor">
                            <label for="cpf">CPF</label>
                            <input type="text" id="cpf" name="cpf" maxlength="14" value="<%= valores.cpf || '' %>">
                        </div>
                        <div class="campo-receptor">
                            <label for="rg">RG</label>
                            <input type="text" id="rg" name="rg" maxlength="30" value="<%= valores.rg || '' %>">
                        </div>
                        <div class="campo-receptor">
                            <label for="sexo">Sexo</label>
                            <select id="sexo" name="sexo">
                                <option value="">Não informado</option>
                                <option value="F" <%= valores.sexo === 'F' ? 'selected' : '' %>>Feminino</option>
                                <option value="M" <%= valores.sexo === 'M' ? 'selected' : '' %>>Masculino</option>
                                <option value="N" <%= valores.sexo === 'N' ? 'selected' : '' %>>Não informado</option>
                            </select>
                        </div>
                        <div class="campo-receptor">
                            <label for="telefone">Telefone</label>
                            <input type="tel" id="telefone" name="telefone" maxlength="30" value="<%= valores.telefone || '' %>">
                        </div>
                        <div class="campo-receptor">
                            <label for="convenio">Convênio</label>
                            <input type="text" id="convenio" name="convenio" maxlength="120" value="<%= valores.convenio || '' %>">
                        </div>
                        <div class="campo-receptor">
                            <label for="plano">Plano</label>
                            <input type="text" id="plano" name="plano" maxlength="120" value="<%= valores.plano || '' %>">
                        </div>
                        <div class="campo-receptor campo-receptor-largo">
                            <label for="observacoes">Observações</label>
                            <textarea id="observacoes" name="observacoes" rows="3"><%= valores.observacoes || '' %></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="modal-rodape">
                <button type="button" class="botao botao-claro" data-fechar-cadastro>Cancelar</button>
                <button type="submit" class="botao botao-inserir">Salvar receptor</button>
            </footer>
        </form>
    </section>
</div>

<%- include('../partials/fim') %>
