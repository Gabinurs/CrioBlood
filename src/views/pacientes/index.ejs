<%- include('../partials/inicio', { titulo: 'Receptores', subtitulo: 'Pesquisa, identificação e histórico transfusional', ativo: 'pacientes' }) %>

<section class="receptor-consulta">
    <div class="painel receptor-busca">
        <div class="receptor-cabecalho-acoes">
            <div class="receptor-titulo">
                <span class="receptor-icone" aria-hidden="true">⌕</span>
                <div>
                    <h3>Consultar receptor</h3>
                    <p>Digite o primeiro nome ou parte do nome para localizar o paciente.</p>
                </div>
            </div>
            <button type="button" class="botao botao-inserir" data-abrir-cadastro>＋ Adicionar receptor</button>
        </div>

        <label class="rotulo-busca" for="busca-receptor">Nome do receptor</label>
        <div class="campo-busca-receptor">
            <input id="busca-receptor" type="search" autocomplete="off"
                placeholder="Digite o nome do paciente..." aria-label="Buscar receptor pelo nome"
                data-busca-receptor aria-controls="sugestoes-receptor" aria-expanded="false">
            <button type="button" class="botao botao-claro botao-limpar-busca" data-limpar-busca aria-label="Limpar busca">Limpar</button>
            <div class="sugestoes-receptor" id="sugestoes-receptor" data-sugestoes-receptor hidden></div>
        </div>
        <small class="ajuda-busca">Os resultados aparecem enquanto você digita. Selecione um nome para abrir as ações.</small>
    </div>

    <div class="painel receptor-resultados">
        <div class="receptor-titulo receptor-titulo-lista">
            <span class="receptor-icone" aria-hidden="true">☷</span>
            <div>
                <h3>Receptor selecionado</h3>
                <p data-instrucao-busca><%= selecionado ? 'Cadastro selecionado.' : 'Nenhum receptor selecionado.' %></p>
            </div>
        </div>
        <div class="receptor-selecionado" data-receptor-selecionado <%= selecionado ? '' : 'hidden' %>
             <% if (selecionado) { %>
             data-id="<%= selecionado.id %>" data-nome="<%= selecionado.nome %>"
             data-nascimento="<%= selecionado.data_nascimento_br %>"
             data-prontuario="<%= selecionado.prontuario || '—' %>"
             data-tipagem="<%= selecionado.abo ? selecionado.abo + selecionado.fator_rh : 'Tipagem pendente' %>"
             data-amostra="<%= selecionado.ultima_amostra_id || '' %>" data-ativo="<%= selecionado.ativo ? 'true' : 'false' %>"
             <% } %>>
            <div class="receptor-selecionado-dados">
                <div><small>Nome do paciente</small><strong data-selecionado-nome><%= selecionado ? selecionado.nome : '' %></strong></div>
                <div><small>Data de nascimento</small><strong data-selecionado-nascimento><%= selecionado ? selecionado.data_nascimento_br : '' %></strong></div>
                <div><small>Prontuário</small><strong data-selecionado-prontuario><%= selecionado ? (selecionado.prontuario || '—') : '' %></strong></div>
                <div><small>ABO / Rh</small><strong data-selecionado-tipagem><%= selecionado && selecionado.abo ? selecionado.abo + selecionado.fator_rh : (selecionado ? 'Tipagem pendente' : '') %></strong></div>
            </div>
            <div class="acoes acoes-receptor">
                <details class="menu-acoes-receptor">
                    <summary>Ações <span aria-hidden="true">▾</span></summary>
                    <div class="menu-acoes-conteudo">
                        <a data-acao-dossie href="<%= selecionado ? '/pacientes/' + selecionado.id + '/dossie' : '#' %>">Dossiê</a>
                        <a data-acao-edicao href="<%= selecionado ? '/pacientes/' + selecionado.id + '/editar' : '#' %>">Edição</a>
                        <a data-acao-amostra href="<%= selecionado ? '/pacientes/' + selecionado.id + '/amostras/nova' : '#' %>">Nova amostra</a>
                        <a data-acao-imuno href="<%= selecionado && selecionado.ultima_amostra_id ? '/pacientes/' + selecionado.id + '/amostras/' + selecionado.ultima_amostra_id + '/imuno' : '#' %>">Imuno</a>
                        <a data-acao-urgencia href="<%= selecionado ? '/solicitacoes/nova?paciente_id=' + selecionado.id + '&urgencia=EXTREMA_URGENCIA' : '#' %>">Extrema urgência</a>
                    </div>
                </details>
                <button type="button" class="botao botao-claro" data-trocar-receptor>Trocar receptor</button>
            </div>
        </div>
        <div class="receptor-inserir" data-receptor-inserir hidden>
            <div>
                <strong>Nenhum receptor encontrado.</strong>
                <span>Confira a pesquisa ou cadastre um novo receptor.</span>
            </div>
            <button type="button" class="botao botao-inserir" data-abrir-cadastro>＋ Inserir receptor</button>
        </div>
    </div>
</section>

<div class="modal-receptor" data-modal-receptor <%= abrirCadastro ? '' : 'hidden' %>>
    <div class="modal-fundo" data-fechar-cadastro></div>
    <section class="modal-conteudo" role="dialog" aria-modal="true" aria-labelledby="titulo-modal-receptor">
        <header class="modal-cabecalho">
            <div><span aria-hidden="true">♙</span><h3 id="titulo-modal-receptor">Cadastro de receptor</h3></div>
            <button type="button" class="modal-fechar" data-fechar-cadastro aria-label="Fechar">×</button>
        </header>
        <form method="POST" action="/pacientes/novo" class="form-receptor-modal">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <div class="modal-corpo">
                <% if (locals.erro) { %><div class="alerta alerta-erro"><%= erro %></div><% } %>
                <div class="secao-modal">
                    <h4>Identificação obrigatória <span>*</span></h4>
                    <div class="grade-receptor-modal">
                        <div class="campo-receptor campo-receptor-largo">
                            <label for="nome">Nome completo *</label>
                            <input type="text" id="nome" name="nome" maxlength="<%= padroes.nomePessoa.max %>" pattern="<%= padroes.nomePessoa.fonte %>" title="<%= padroes.nomePessoa.mensagem %>" value="<%= valores.nome || '' %>" required autocomplete="name">
                        </div>
                        <div class="campo-receptor">
                            <label for="data_nascimento">Data de nascimento *</label>
                            <input type="date" id="data_nascimento" name="data_nascimento" value="<%= valores.data_nascimento || '' %>" required>
                        </div>
                        <div class="campo-receptor">
                            <label for="nome_mae">Nome da mãe *</label>
                            <input type="text" id="nome_mae" name="nome_mae" maxlength="<%= padroes.nomePessoa.max %>" pattern="<%= padroes.nomePessoa.fonte %>" title="<%= padroes.nomePessoa.mensagem %>" data-mascara="nome" value="<%= valores.nome_mae || '' %>" required>
                        </div>
                    </div>
                </div>
                <div class="secao-modal">
                    <h4>Informações complementares <small>(opcional)</small></h4>
                    <div class="grade-receptor-modal">
                        <div class="campo-receptor"><label for="prontuario">Prontuário</label><input type="text" id="prontuario" name="prontuario" maxlength="<%= padroes.prontuario.max %>" pattern="<%= padroes.prontuario.fonte %>" title="<%= padroes.prontuario.mensagem %>" value="<%= valores.prontuario || '' %>"></div>
                        <div class="campo-receptor"><label for="cns">CNS</label><input type="text" id="cns" name="cns" maxlength="<%= padroes.cns.max %>" value="<%= valores.cns || '' %>"></div>
                        <div class="campo-receptor"><label for="cpf">CPF</label><input type="text" id="cpf" name="cpf" maxlength="<%= padroes.cpf.max %>" value="<%= valores.cpf || '' %>"></div>
                        <div class="campo-receptor"><label for="rg">RG</label><input type="text" id="rg" name="rg" maxlength="<%= padroes.rg.max %>" value="<%= valores.rg || '' %>"></div>
                        <div class="campo-receptor">
                            <label for="sexo">Sexo</label>
                            <select id="sexo" name="sexo"><option value="">Não informado</option><option value="F" <%= valores.sexo === 'F' ? 'selected' : '' %>>Feminino</option><option value="M" <%= valores.sexo === 'M' ? 'selected' : '' %>>Masculino</option></select>
                        </div>
                        <div class="campo-receptor"><label for="telefone">Telefone</label><input type="tel" id="telefone" name="telefone" maxlength="<%= padroes.telefone.max %>" value="<%= valores.telefone || '' %>"></div>
                        <div class="campo-receptor"><label for="convenio">Convênio</label><input type="text" id="convenio" name="convenio" maxlength="120" value="<%= valores.convenio || '' %>"></div>
                        <div class="campo-receptor"><label for="plano">Plano</label><input type="text" id="plano" name="plano" maxlength="120" value="<%= valores.plano || '' %>"></div>
                        <div class="campo-receptor campo-receptor-largo"><label for="observacoes">Observações</label><textarea id="observacoes" name="observacoes" rows="3"><%= valores.observacoes || '' %></textarea></div>
                    </div>
                </div>
            </div>
            <footer class="modal-rodape">
                <button type="button" class="botao botao-claro" data-fechar-cadastro>Cancelar</button>
                <button type="submit" class="botao botao-inserir">Salvar receptor</button>
            </footer>
        </form>
    </section>
</div>

<script src="/js/receptores.js" defer></script>
<%- include('../partials/fim') %>
