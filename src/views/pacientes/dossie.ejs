<%- include('../partials/inicio',{titulo:'Dossiê do receptor',subtitulo:'Dados cadastrais, amostras e histórico transfusional',ativo:'pacientes'}) %>
<section class="painel">
    <div class="cabecalho-pagina">
        <div><h3><%= paciente.nome %></h3><p>Nascimento: <%= paciente.data_nascimento_br %> · Mãe: <%= paciente.nome_mae || 'Não informado' %></p></div>
        <div class="acoes">
            <a class="botao botao-claro" href="/pacientes">Voltar</a>
            <a class="botao botao-claro" href="/pacientes/<%= paciente.id %>/editar">Edição</a>
            <a class="botao" href="/pacientes/<%= paciente.id %>/amostras/nova">+ Nova amostra</a>
        </div>
    </div>
    <div class="detalhes">
        <% [['Prontuário',paciente.prontuario],['CNS',paciente.cns],['CPF',paciente.cpf],['RG',paciente.rg],['Telefone',paciente.telefone],['Convênio',paciente.convenio],['Plano',paciente.plano],['ABO/Rh',paciente.abo ? paciente.abo+paciente.fator_rh : 'Pendente']].forEach(function(item){ %>
        <div><span><%= item[0] %></span><strong><%= item[1] || 'Não informado' %></strong></div>
        <% }) %>
    </div>

    <div class="dossie-liberacao">
        <strong>Solicitação transfusional:</strong>
        <span class="status <%= liberacao.permitido ? 's-verde' : 's-vermelho' %>"><%= liberacao.permitido ? 'Pré-requisitos registrados' : 'Bloqueada' %></span>
        <p><%= liberacao.permitido ? 'A amostra mais recente atende às regras cadastrais do sistema. A solicitação ainda depende das verificações e autorizações profissionais institucionais.' : liberacao.motivo %></p>
    </div>

    <h3 id="amostras">Histórico de amostras</h3>
    <div class="tabela-container">
        <table>
            <thead><tr><th>Código</th><th>Coleta</th><th>Recebimento</th><th>ABO/Rh</th><th>Controle</th><th>PAI</th><th>Validade</th><th>Imuno</th><th>Ações</th></tr></thead>
            <tbody>
            <% if (!amostras.length) { %>
                <tr><td colspan="9" class="vazio">Nenhuma amostra registrada.</td></tr>
            <% } else { amostras.forEach(function(a){ %>
                <tr>
                    <td><strong><%= a.codigo %></strong></td>
                    <td><%= a.coleta_br %></td>
                    <td><%= a.recebimento_br %></td>
                    <td><strong><%= a.abo ? a.abo + a.fator_rh : 'Pendente' %></strong></td>
                    <td><%= a.controle_rh || 'Pendente' %><% if(a.controle_rh==='POSITIVO'){ %><br><small><%= a.controle_rh_justificativa %></small><% } %></td>
                    <td><%= a.pai || 'Pendente' %><% if(a.pai==='POSITIVO'){ %><br><small><%= a.pai_justificativa %></small><% } %></td>
                    <td><%= a.validade_br %><br><span class="status <%= a.valida ? 's-verde' : 's-vermelho' %>"><%= a.valida ? 'Dentro de 72h' : 'Vencida' %></span></td>
                    <td><span class="status <%= a.status_imuno==='CONCLUIDO' ? 's-verde' : a.status_imuno==='BLOQUEADO' ? 's-vermelho' : 's-amarelo' %>"><%= a.status_imuno==='CONCLUIDO' ? 'Concluído' : a.status_imuno==='BLOQUEADO' ? 'Bloqueado' : 'Pendente' %></span></td>
                    <td class="acoes">
                        <button type="button" class="botao botao-claro botao-pequeno" data-amostra-modal-url="/pacientes/<%= paciente.id %>/amostras/<%= a.id %>/imuno" data-amostra-modal-titulo="Imuno-hematologia">Imuno</button>
                        <button type="button" class="botao botao-claro botao-pequeno" data-amostra-modal-url="/pacientes/<%= paciente.id %>/amostras/<%= a.id %>/etiqueta" data-amostra-modal-titulo="Etiqueta de identificação">Etiqueta</button>
                    </td>
                </tr>
            <% }) } %>
            </tbody>
        </table>
    </div>
</section>

<dialog class="modal-amostra-dialog" data-amostra-modal aria-labelledby="titulo-modal-amostra">
    <header class="modal-amostra-topo">
        <div><span class="modal-amostra-marca">CRIOBLOOD</span><h3 id="titulo-modal-amostra" data-amostra-modal-titulo>Detalhes da amostra</h3></div>
        <button type="button" class="modal-amostra-fechar" data-amostra-modal-fechar aria-label="Fechar janela">×</button>
    </header>
    <iframe class="modal-amostra-frame" data-amostra-modal-frame title="Conteúdo da amostra" loading="eager"></iframe>
</dialog>
<script src="/js/amostras-modal.js" defer></script>

<%- include('../partials/fim') %>