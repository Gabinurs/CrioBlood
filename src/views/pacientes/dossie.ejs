<%- include('../partials/inicio',{titulo:'Dossiê do receptor',subtitulo:'Dados cadastrais e histórico de amostras',ativo:'pacientes'}) %>
<section class="painel">
    <div class="cabecalho-pagina"><div><h3><%= paciente.nome %></h3><p>Nascimento: <%= paciente.data_nascimento_br %> · Mãe: <%= paciente.nome_mae || 'Não informado' %></p></div>
    <div class="acoes"><a class="botao botao-claro" href="/pacientes">Voltar</a><a class="botao botao-claro" href="/pacientes/<%= paciente.id %>/editar">Editar cadastro</a><a class="botao" href="/pacientes/<%= paciente.id %>/amostras/nova">+ Nova amostra</a></div></div>
    <div class="detalhes">
        <% [['Prontuário',paciente.prontuario],['CNS',paciente.cns],['CPF',paciente.cpf],['RG',paciente.rg],['Telefone',paciente.telefone],['Convênio',paciente.convenio],['Plano',paciente.plano],['ABO/Rh',paciente.abo ? paciente.abo+paciente.fator_rh : 'Pendente']].forEach(function(item){ %>
        <div><span><%= item[0] %></span><strong><%= item[1] || 'Não informado' %></strong></div><% }) %>
    </div>
    <h3>Histórico de amostras</h3>
    <div class="tabela-container"><table><thead><tr><th>Código</th><th>Coleta</th><th>Recebimento</th><th>ABO/Rh</th><th>Controle Rh</th><th>PAI</th><th>Validade</th><th>Status</th></tr></thead><tbody>
    <% if (!amostras.length) { %><tr><td colspan="8" class="vazio">Nenhuma amostra registrada.</td></tr><% } else { amostras.forEach(function(a){ %>
    <tr><td><%= a.codigo %></td><td><%= a.coleta_br %></td><td><%= a.recebimento_br %></td><td><strong><%= a.abo %><%= a.fator_rh %></strong></td><td><%= a.controle_rh %></td><td><%= a.pai %><% if(a.pai==='POSITIVO'){ %><br><small><%= a.pai_justificativa %></small><% } %></td><td><%= a.validade_br %></td><td><span class="status <%= a.valida && a.pai==='NEGATIVO'?'s-verde':'s-vermelho' %>"><%= !a.valida?'Vencida':a.pai==='POSITIVO'?'PAI positivo':'Válida' %></span></td></tr>
    <% }) } %></tbody></table></div>
</section>
<%- include('../partials/fim') %>