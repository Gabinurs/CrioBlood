<%- include('../partials/inicio',{titulo:'Imuno-hematologia',subtitulo:'Registro dos testes realizados na amostra',ativo:'pacientes'}) %>
<section class="painel formulario amostra-form">
    <div class="amostra-cabecalho">
        <div><span>RECEPTOR</span><h3><%= paciente.nome %></h3><p>Amostra <strong><%= amostra.codigo %></strong> · Coleta: <%= amostra.coleta_br %></p></div>
        <div class="amostra-validade"><strong>72 horas</strong><small>Validade até <%= amostra.validade_br %></small></div>
    </div>
    <% if (locals.erro) { %><div class="alerta alerta-erro"><%= erro %></div><% } %>
    <% if (!amostra.valida) { %><div class="alerta alerta-erro">Esta amostra está fora da validade. Os resultados podem ser registrados para histórico, mas ela não poderá liberar uma solicitação transfusional.</div><% } %>
    <form method="POST" action="/pacientes/<%= paciente.id %>/amostras/<%= amostra.id %>/imuno" data-form-imuno>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <input type="hidden" name="pai_justificativa" value="<%= amostra.pai_justificativa || '' %>">
        <input type="hidden" name="controle_rh_justificativa" value="<%= amostra.controle_rh_justificativa || '' %>">
        <h3 class="titulo-secao-amostra">Tipagem sanguínea</h3>
        <div class="grade-form">
            <div class="campo"><label>ABO *</label><select name="abo" required><option value="">Selecione</option><% ['A','B','AB','O'].forEach(x=>{ %><option value="<%= x %>" <%= amostra.abo===x?'selected':'' %>><%= x %></option><% }) %></select></div>
            <div class="campo"><label>Fator Rh *</label><select name="fator_rh" required><option value="">Selecione</option><option value="+" <%= amostra.fator_rh==='+'?'selected':'' %>>Positivo (+)</option><option value="-" <%= amostra.fator_rh==='-'?'selected':'' %>>Negativo (-)</option></select></div>
        </div>
        <hr class="separador-amostra">
        <h3 class="titulo-secao-amostra">Testes imuno-hematológicos</h3>
        <div class="grade-form">
            <div class="campo"><label>Controle *</label><select name="controle_rh" data-imuno-resultado="controle" required><option value="">Selecione</option><option value="NEGATIVO" <%= amostra.controle_rh==='NEGATIVO'?'selected':'' %>>Negativo</option><option value="POSITIVO" <%= amostra.controle_rh==='POSITIVO'?'selected':'' %>>Positivo</option></select></div>
            <div class="campo"><label>PAI *</label><select name="pai" data-imuno-resultado="pai" required><option value="">Selecione</option><option value="NEGATIVO" <%= amostra.pai==='NEGATIVO'?'selected':'' %>>Negativo</option><option value="POSITIVO" <%= amostra.pai==='POSITIVO'?'selected':'' %>>Positivo</option></select></div>
        </div>
        <div class="alerta alerta-aviso">Se PAI ou Controle apresentar resultado positivo, o sistema solicitará justificativa e bloqueará a abertura da solicitação transfusional até avaliação e liberação conforme protocolo institucional.</div>
        <div class="rodape-form"><button class="botao" type="submit">Salvar resultados</button><a class="botao botao-claro" href="/pacientes/<%= paciente.id %>/dossie">Voltar ao dossiê</a></div>
    </form>
</section>
<dialog class="modal-justificativa-imuno" data-modal-justificativa>
    <form method="dialog">
        <h3 data-titulo-justificativa>Justificativa obrigatória</h3>
        <p data-texto-justificativa>Informe o motivo do resultado positivo.</p>
        <textarea data-campo-justificativa rows="4" minlength="5" placeholder="Descreva a justificativa..."></textarea>
        <div class="acoes-modal-justificativa"><button type="button" class="botao botao-claro" data-cancelar-justificativa>Cancelar</button><button type="button" class="botao" data-confirmar-justificativa>Confirmar</button></div>
    </form>
</dialog>

<%- include('../partials/fim') %>