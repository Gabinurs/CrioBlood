<%
    var edicao = !!locals.paciente;
    var v = function (campo) {
        if (locals.valores && locals.valores[campo] !== undefined) return valores[campo];
        if (edicao) {
            var mapa = { data_nascimento: 'data_nascimento_iso' };
            return paciente[mapa[campo] || campo] || '';
        }
        return '';
    };
    var ativo = edicao ? (locals.valores && Object.keys(valores).length ? valores.ativo === 'on' : paciente.ativo) : true;
%>
<%- include('../partials/inicio', {
    titulo: 'Editar receptor',
    subtitulo: 'Atualização dos dados cadastrais do receptor',
    ativo: 'pacientes'
}) %>

<section class="painel formulario">
    <form method="POST" action="/pacientes/<%= paciente.id %>/editar">
        <div class="grade-form">
            <div class="campo largo">
                <label for="nome">Nome completo *</label>
                <input type="text" id="nome" name="nome" maxlength="255" value="<%= v('nome') %>" required>
            </div>
            <div class="campo">
                <label for="data_nascimento">Data de nascimento *</label>
                <input type="date" id="data_nascimento" name="data_nascimento" value="<%= v('data_nascimento') %>" required>
            </div>
            <div class="campo">
                <label for="nome_mae">Nome da mãe *</label>
                <input type="text" id="nome_mae" name="nome_mae" maxlength="255" value="<%= v('nome_mae') %>" required>
            </div>
            <div class="campo">
                <label for="prontuario">Prontuário</label>
                <input type="text" id="prontuario" name="prontuario" maxlength="50" value="<%= v('prontuario') %>">
            </div>
            <div class="campo">
                <label for="cns">CNS</label>
                <input type="text" id="cns" name="cns" maxlength="20" value="<%= v('cns') %>">
            </div>
            <div class="campo">
                <label for="cpf">CPF</label>
                <input type="text" id="cpf" name="cpf" maxlength="14" value="<%= v('cpf') %>">
            </div>
            <div class="campo">
                <label for="rg">RG</label>
                <input type="text" id="rg" name="rg" maxlength="30" value="<%= v('rg') %>">
            </div>
            <div class="campo">
                <label for="sexo">Sexo</label>
                <select id="sexo" name="sexo">
                    <option value="">Não informado</option>
                    <option value="F" <%= v('sexo') === 'F' ? 'selected' : '' %>>Feminino</option>
                    <option value="M" <%= v('sexo') === 'M' ? 'selected' : '' %>>Masculino</option>
                    <option value="N" <%= v('sexo') === 'N' ? 'selected' : '' %>>Não informado</option>
                </select>
            </div>
            <div class="campo">
                <label for="telefone">Telefone</label>
                <input type="tel" id="telefone" name="telefone" maxlength="30" value="<%= v('telefone') %>">
            </div>
            <div class="campo">
                <label for="convenio">Convênio</label>
                <input type="text" id="convenio" name="convenio" maxlength="120" value="<%= v('convenio') %>">
            </div>
            <div class="campo">
                <label for="plano">Plano</label>
                <input type="text" id="plano" name="plano" maxlength="120" value="<%= v('plano') %>">
            </div>
            <div class="campo largo">
                <label for="observacoes">Observações</label>
                <textarea id="observacoes" name="observacoes" rows="3"><%= v('observacoes') %></textarea>
            </div>
            <div class="campo largo">
                <label class="marca"><input type="checkbox" name="ativo" <%= ativo ? 'checked' : '' %>> Receptor ativo</label>
            </div>
        </div>
        <div class="rodape-form">
            <button class="botao" type="submit">Salvar alterações</button>
            <a class="botao botao-claro" href="/pacientes">Voltar</a>
        </div>
    </form>
</section>

<%- include('../partials/fim') %>
